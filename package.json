{
  "name": "@aranshayan/mcp-database",
  "version": "0.1.1",
  "description": "Safe, read-only-by-default MCP server for PostgreSQL, MySQL and SQLite: schema discovery, guarded queries, row limits and timeouts.",
  "mcpName": "io.github.aranshayan/mcp-database",
  "type": "module",
  "bin": {
    "mcp-database": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "sql",
    "postgres",
    "postgresql",
    "mysql",
    "sqlite",
    "database",
    "claude"
  ],
  "author": "aranshayan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aranshayan/mcp-database.git"
  },
  "homepage": "https://github.com/aranshayan/mcp-database#readme",
  "bugs": {
    "url": "https://github.com/aranshayan/mcp-database/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "mysql2": "^3.24.6",
    "pg": "^8.23.1",
    "pg-cursor": "^2.22.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.6.0",
    "@electric-sql/pglite-socket": "^0.3.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/pg-cursor": "^2.7.2",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
